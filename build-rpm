#!/bin/bash
# build_rpm.sh - One-step RPM build for Skin Cancer Detection App
# Tested layout: root app.py + clinical/ models/ utils/ static/ templates/ screenshots/

set -e

# ---------------- Colors ----------------
GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; BLUE='\033[0;34m'; NC='\033[0m'

# ---------------- Configuration ----------------
APP_NAME="skincancer"
VERSION="1.0.0"
RELEASE="1"
MAINTAINER="KYGnus <kygnus.co@proton.me>"
DESCRIPTION="Skin Cancer Detection - AI-powered skin lesion classification using deep learning"
URL="https://github.com/KooshaYeganeh/skin-cancer"
LICENSE="MIT"
ARCH="noarch"

APP_PORT="5005"
APP_HOST="0.0.0.0"

RPMBUILD_DIR="$(pwd)/rpmbuild"
SPECS_DIR="${RPMBUILD_DIR}/SPECS"
SOURCES_DIR="${RPMBUILD_DIR}/SOURCES"
STAGE_DIR="${RPMBUILD_DIR}/stage/${APP_NAME}-${VERSION}"

echo -e "${GREEN}🚀 Building .rpm for ${APP_NAME} ${VERSION} (port ${APP_PORT})${NC}"

# ---------------- Prereq check ----------------
if ! command -v rpmbuild &>/dev/null; then
    echo -e "${RED}❌ rpmbuild not found.${NC}"
    echo "   Fedora/RHEL:   sudo dnf install rpm-build rpmdevtools"
    echo "   Debian/Ubuntu: sudo apt-get install rpm rsync"
    exit 1
fi
if ! command -v rsync &>/dev/null; then
    echo -e "${RED}❌ rsync not found.${NC}"
    echo "   Fedora/RHEL:   sudo dnf install rsync"
    echo "   Debian/Ubuntu: sudo apt-get install rsync"
    exit 1
fi

# ---------------- Silence hostname warning ----------------
if ! grep -q "^%_buildhost" ~/.rpmmacros 2>/dev/null; then
    echo '%_buildhost localhost' >> ~/.rpmmacros
    echo -e "${BLUE}ℹ️  Added '%_buildhost localhost' to ~/.rpmmacros${NC}"
fi

# ---------------- Clean ----------------
echo -e "${YELLOW}🧹 Cleaning previous builds...${NC}"
rm -rf "${RPMBUILD_DIR}"
rm -f ${APP_NAME}-*.rpm
mkdir -p "${SPECS_DIR}" "${SOURCES_DIR}" "${STAGE_DIR}" \
         "${RPMBUILD_DIR}/BUILD" "${RPMBUILD_DIR}/RPMS" "${RPMBUILD_DIR}/SRPMS"

# ---------------- Stage sources ----------------
echo -e "${YELLOW}📦 Staging sources...${NC}"

for f in app.py config.py requirements.txt; do
    if [ ! -e "$f" ]; then
        echo -e "${RED}❌ Missing required file: $f${NC}"
        exit 1
    fi
done

copy_tree() {
    local src="$1"
    [ -e "$src" ] || return 0
    rsync -a --exclude='venv/' \
             --exclude='.venv/' \
             --exclude='__pycache__/' \
             --exclude='*.pyc' \
             --exclude='*.pyo' \
             --exclude='.git/' \
             --exclude='.idea/' \
             --exclude='.vscode/' \
             --exclude='rpmbuild/' \
             --exclude='deb_package/' \
             --exclude='*.deb' \
             --exclude='*.rpm' \
             "$src" "${STAGE_DIR}/"
}

copy_tree app.py
copy_tree config.py
copy_tree LICENSE
copy_tree README.md
copy_tree requirements.txt
copy_tree clinical
copy_tree models
copy_tree utils
copy_tree static
copy_tree templates
copy_tree screenshots

# Fallback requirements if file is empty
if [ ! -s "${STAGE_DIR}/requirements.txt" ]; then
    echo -e "${YELLOW}⚠️  requirements.txt empty, writing default...${NC}"
    cat > "${STAGE_DIR}/requirements.txt" << 'REQ'
flask>=2.3.0
torch>=2.1.0
torchvision>=0.16.0
ultralytics>=8.0.0
transformers>=4.35.0
numpy>=1.24.0
pillow>=10.0.0
opencv-python>=4.8.0
scikit-learn>=1.3.0
matplotlib>=3.7.0
tqdm>=4.65.0
REQ
fi

# ---------------- Tarball ----------------
TARBALL="${SOURCES_DIR}/${APP_NAME}-${VERSION}.tar.gz"
tar -czf "${TARBALL}" -C "${RPMBUILD_DIR}/stage" "${APP_NAME}-${VERSION}"
echo -e "${GREEN}✅ Tarball: $(basename ${TARBALL})${NC}"

# ---------------- Helper: post-install ----------------
echo -e "${YELLOW}📝 Writing helper scripts...${NC}"

cat > "${SOURCES_DIR}/post-install.sh" << POSTINST_EOF
#!/bin/bash
set -e

APP_DIR="/usr/share/${APP_NAME}"

echo "🔧 Setting up ${APP_NAME}..."

# Create runtime dirs
mkdir -p /var/log/${APP_NAME} \\
         /var/lib/${APP_NAME}/uploads \\
         /var/lib/${APP_NAME}/models \\
         /var/lib/${APP_NAME}/results \\
         /etc/${APP_NAME}

# Ensure python3
if ! command -v python3 >/dev/null; then
    echo "❌ python3 is required but not installed."
    exit 1
fi

PY_VER=\$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')
echo "ℹ️  Found Python \$PY_VER"

# Ensure pip + venv
if ! python3 -m pip --version >/dev/null 2>&1 || ! python3 -m venv --help >/dev/null 2>&1; then
    echo "📦 Installing pip / venv bootstrap..."
    if command -v dnf >/dev/null; then
        dnf install -y python3-pip python3-virtualenv python3-devel gcc gcc-c++ || true
    elif command -v yum >/dev/null; then
        yum install -y python3-pip python3-virtualenv python3-devel gcc gcc-c++ || true
    elif command -v apt-get >/dev/null; then
        apt-get update && apt-get install -y python3-pip python3-venv python3-dev gcc g++ || true
    fi
fi

# GPU check (informational)
if command -v nvidia-smi >/dev/null; then
    echo "✅ NVIDIA GPU detected - CUDA support available"
else
    echo "ℹ️  No NVIDIA GPU detected - CPU mode"
fi

cd "\$APP_DIR"

# Fresh virtualenv
rm -rf venv
echo "🐍 Creating virtualenv with Python \$PY_VER..."
python3 -m venv venv
source venv/bin/activate
pip install --upgrade pip wheel setuptools

echo "📦 Installing Python dependencies (this may take a few minutes)..."
if [ -s requirements.txt ]; then
    pip install -r requirements.txt
else
    pip install flask torch torchvision ultralytics transformers numpy pillow \\
                opencv-python scikit-learn matplotlib tqdm
fi

# GPU tensorflow/torch info (best-effort)
python - <<'PYEOF' || true
try:
    import torch
    print(f"Torch version: {torch.__version__}")
    print(f"CUDA available: {torch.cuda.is_available()}")
except Exception as e:
    print(f"torch import check skipped: {e}")
PYEOF

deactivate

# Default config if missing
if [ ! -f /etc/${APP_NAME}/config.py ]; then
    echo "📝 Writing default /etc/${APP_NAME}/config.py"
    cat > /etc/${APP_NAME}/config.py << 'CONFIG'
# Skin Cancer Detection - Configuration File
HOST = '${APP_HOST}'
PORT = ${APP_PORT}
DEBUG = False
SECRET_KEY = 'change-this-secret-key-in-production'

BASE_DIR   = '/usr/share/${APP_NAME}'
LOG_DIR    = '/var/log/${APP_NAME}'
UPLOAD_DIR = '/var/lib/${APP_NAME}/uploads'
MODEL_DIR  = '/var/lib/${APP_NAME}/models'
RESULT_DIR = '/var/lib/${APP_NAME}/results'

IMAGE_SIZE = (224, 224)
BATCH_SIZE = 32
CONFIDENCE_THRESHOLD = 0.5

CLASS_NAMES = [
    'Melanoma',
    'Melanocytic Nevus',
    'Basal Cell Carcinoma',
    'Actinic Keratosis',
    'Benign Keratosis',
    'Dermatofibroma',
    'Vascular Lesion',
]

MAX_FILE_SIZE = 10 * 1024 * 1024
ALLOWED_EXTENSIONS = {'png', 'jpg', 'jpeg', 'bmp'}

LOG_LEVEL  = 'INFO'
LOG_FORMAT = '%(asctime)s - %(name)s - %(levelname)s - %(message)s'
CONFIG
fi

# Launcher
cat > /usr/bin/${APP_NAME} << 'LAUNCHER'
#!/bin/bash
cd /usr/share/${APP_NAME}
export PYTHONPATH=/usr/share/${APP_NAME}
source venv/bin/activate
export FLASK_APP=app.py
export FLASK_ENV=production
export SKIN_CANCER_CONFIG=/etc/${APP_NAME}/config.py
exec python app.py "\$@"
LAUNCHER
chmod 755 /usr/bin/${APP_NAME}

# Systemd unit
cat > /etc/systemd/system/${APP_NAME}.service << 'SERVICE'
[Unit]
Description=Skin Cancer Detection Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/usr/share/${APP_NAME}
Environment="PATH=/usr/share/${APP_NAME}/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="FLASK_APP=app.py"
Environment="FLASK_ENV=production"
Environment="SKIN_CANCER_CONFIG=/etc/${APP_NAME}/config.py"
Environment="PYTHONPATH=/usr/share/${APP_NAME}"
ExecStart=/usr/share/${APP_NAME}/venv/bin/python /usr/share/${APP_NAME}/app.py
Restart=always
RestartSec=10
StandardOutput=append:/var/log/${APP_NAME}/access.log
StandardError=append:/var/log/${APP_NAME}/error.log

[Install]
WantedBy=multi-user.target
SERVICE

systemctl daemon-reload 2>/dev/null || true

# Permissions
chown -R root:root /usr/share/${APP_NAME}
chmod 755 /usr/share/${APP_NAME}
chmod 755 /var/log/${APP_NAME} \\
          /var/lib/${APP_NAME}/uploads \\
          /var/lib/${APP_NAME}/models \\
          /var/lib/${APP_NAME}/results
chmod 644 /etc/${APP_NAME}/config.py

echo "✅ Setup complete."
exit 0
POSTINST_EOF
chmod 755 "${SOURCES_DIR}/post-install.sh"

# ---------------- Helper: posttrans (self-test) ----------------
cat > "${SOURCES_DIR}/post-trans.sh" << 'POSTTRANS_EOF'
#!/bin/bash
# %posttrans: runs after the whole transaction — safe place to test the service.

APP_PORT="__PORT__"
APP_NAME="__NAME__"
LOG="/var/log/${APP_NAME}/error.log"

echo "🔍 Verifying ${APP_NAME} service..."

# Try to start (do not enable — leave that to the admin)
systemctl start ${APP_NAME}.service 2>/dev/null || true

# Wait up to 30s for the port to answer
for i in $(seq 1 30); do
    if curl -fsS -o /dev/null "http://127.0.0.1:${APP_PORT}/" 2>/dev/null; then
        echo "✅ ${APP_NAME} is responding on port ${APP_PORT}"
        exit 0
    fi
    sleep 1
done

# It didn't come up — report, but don't fail the install.
echo "⚠️  ${APP_NAME} did not respond on port ${APP_PORT} within 30s."
echo "    Check the logs:"
echo "        journalctl -u ${APP_NAME} -n 80 --no-pager"
echo "        tail -n 80 ${LOG}"
echo "    Then start manually:"
echo "        sudo systemctl start ${APP_NAME}"
exit 0
POSTTRANS_EOF

# Substitute placeholders
sed -i "s/__PORT__/${APP_PORT}/g; s/__NAME__/${APP_NAME}/g" "${SOURCES_DIR}/post-trans.sh"
chmod 755 "${SOURCES_DIR}/post-trans.sh"

# ---------------- Helper: pre-uninstall ----------------
cat > "${SOURCES_DIR}/pre-uninstall.sh" << PREUN_EOF
#!/bin/bash
systemctl stop ${APP_NAME} 2>/dev/null || true
systemctl disable ${APP_NAME} 2>/dev/null || true
exit 0
PREUN_EOF
chmod 755 "${SOURCES_DIR}/pre-uninstall.sh"

# ---------------- Helper: post-uninstall ----------------
cat > "${SOURCES_DIR}/post-uninstall.sh" << POSTUN_EOF
#!/bin/bash
# \$1 = 0 for real uninstall, 1 for upgrade
if [ "\$1" = "0" ]; then
    rm -f /etc/systemd/system/${APP_NAME}.service
    systemctl daemon-reload 2>/dev/null || true
    rm -f /usr/bin/${APP_NAME}
    # Data is intentionally preserved. Uncomment to purge:
    # rm -rf /usr/share/${APP_NAME} /var/log/${APP_NAME} /var/lib/${APP_NAME} /etc/${APP_NAME}
fi
exit 0
POSTUN_EOF
chmod 755 "${SOURCES_DIR}/post-uninstall.sh"

# ---------------- Spec file ----------------
echo -e "${YELLOW}📝 Writing spec file...${NC}"

cat > "${SPECS_DIR}/${APP_NAME}.spec" << SPEC
Name:           ${APP_NAME}
Version:        ${VERSION}
Release:        ${RELEASE}%{?dist}
Summary:        ${DESCRIPTION}
License:        ${LICENSE}
URL:            ${URL}
Source0:        %{name}-%{version}.tar.gz
Source1:        post-install.sh
Source2:        pre-uninstall.sh
Source3:        post-uninstall.sh
Source4:        post-trans.sh

BuildArch:      ${ARCH}
Requires:       python3 >= 3.8
Requires:       python3-pip
Requires:       python3-virtualenv
Requires:       python3-devel
Requires:       gcc
Requires:       gcc-c++
Requires:       curl

%description
${DESCRIPTION}

AI-powered skin lesion classification using deep learning.
Classes: Melanoma, Melanocytic Nevus, Basal Cell Carcinoma, Actinic Keratosis,
Benign Keratosis, Dermatofibroma, Vascular Lesion.

%prep
%setup -q

%build
# Pure Python — nothing to compile

%install
rm -rf %{buildroot}
install -d %{buildroot}/usr/share/${APP_NAME}
install -d %{buildroot}/usr/share/doc/${APP_NAME}
install -d %{buildroot}/usr/share/applications
install -d %{buildroot}/usr/bin
install -d %{buildroot}/etc/${APP_NAME}
install -d %{buildroot}/var/log/${APP_NAME}
install -d %{buildroot}/var/lib/${APP_NAME}/uploads
install -d %{buildroot}/var/lib/${APP_NAME}/models
install -d %{buildroot}/var/lib/${APP_NAME}/results

# Top-level files
for f in app.py config.py LICENSE README.md requirements.txt; do
    [ -e "\$f" ] && cp -a "\$f" %{buildroot}/usr/share/${APP_NAME}/
done

# Packages and assets
for d in clinical models utils static templates screenshots; do
    [ -d "\$d" ] && cp -a "\$d" %{buildroot}/usr/share/${APP_NAME}/
done

# Doc
cat > %{buildroot}/usr/share/doc/${APP_NAME}/README << 'EOF'
${DESCRIPTION}

Quick start:
  1. Edit config:  sudo nano /etc/${APP_NAME}/config.py
  2. Start:        sudo systemctl start ${APP_NAME}
  3. Access:       http://localhost:${APP_PORT}
EOF

# Desktop entry
cat > %{buildroot}/usr/share/applications/${APP_NAME}.desktop << 'EOF'
[Desktop Entry]
Version=1.0
Type=Application
Name=Skin Cancer Detection
Comment=AI-powered skin cancer detection
Exec=${APP_NAME}
Icon=medical
Terminal=false
Categories=Science;Medicine;Healthcare;
Keywords=skin;cancer;detection;ai;machine-learning
EOF

# Permissions
find %{buildroot} -type d -exec chmod 755 {} \\;
find %{buildroot} -name "*.py" -exec chmod 644 {} \\;
chmod 755 %{buildroot}/usr/share/${APP_NAME}/app.py

%post
bash %{_sourcedir}/post-install.sh || true

%preun
bash %{_sourcedir}/pre-uninstall.sh || true

%postun
bash %{_sourcedir}/post-uninstall.sh "\$1" || true

%posttrans
bash %{_sourcedir}/post-trans.sh || true

%files
/usr/share/${APP_NAME}
/usr/share/doc/${APP_NAME}
/usr/share/applications/${APP_NAME}.desktop
%dir /etc/${APP_NAME}
%dir /var/log/${APP_NAME}
%dir /var/lib/${APP_NAME}
%dir /var/lib/${APP_NAME}/uploads
%dir /var/lib/${APP_NAME}/models
%dir /var/lib/${APP_NAME}/results

%changelog
* $(LC_ALL=C date '+%a %b %d %Y') ${MAINTAINER} - ${VERSION}-${RELEASE}
- Initial RPM package for ${APP_NAME}
SPEC

# ---------------- Build ----------------
echo -e "${YELLOW}🔨 Running rpmbuild...${NC}"
rpmbuild --define "_topdir ${RPMBUILD_DIR}" -bb "${SPECS_DIR}/${APP_NAME}.spec"

BUILT=$(find "${RPMBUILD_DIR}/RPMS" -name "${APP_NAME}-${VERSION}-${RELEASE}*.rpm" | head -n1)
[ -z "${BUILT}" ] && { echo -e "${RED}❌ Build produced no RPM${NC}"; exit 1; }

cp "${BUILT}" .
FINAL=$(basename "${BUILT}")
rm -rf "${RPMBUILD_DIR}"

echo ""
echo -e "${GREEN}✅ Created: ${FINAL}  ($(du -h ${FINAL} | cut -f1))${NC}"
echo ""
echo -e "${GREEN}Install:${NC}"
echo "  sudo dnf install ./${FINAL}     # or: sudo rpm -ivh ${FINAL}"
echo ""
echo -e "${GREEN}Uninstall:${NC}"
echo "  sudo rpm -e ${APP_NAME}"
echo ""
echo -e "${GREEN}Start:${NC}"
echo "  sudo systemctl start ${APP_NAME} && sudo systemctl enable ${APP_NAME}"
echo ""
echo -e "${GREEN}Access:${NC}"
echo "  http://localhost:${APP_PORT}"
echo ""
echo -e "${BLUE}ℹ️  GPU: install nvidia drivers + cuda-toolkit for accelerated inference${NC}"
